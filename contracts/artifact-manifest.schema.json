{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simphoni.ai/schemas/sheets/artifact-manifest.v1.json",
  "title": "SimphoniSheetsArtifactManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release", "artifact", "version", "platform", "sourceRevisions", "sha256", "sizeBytes", "signature", "signingKeyId", "sbom", "buildReceipt", "licenseManifest", "sourceArchives"],
  "properties": {
    "schema": { "const": "ai.simphoni.sheets.artifact.v1" },
    "release": { "type": "string", "minLength": 1 },
    "artifact": { "enum": ["collabora-linux-arm64", "calc-darwin-arm64", "calc-linux-amd64", "offline-ui"] },
    "version": { "type": "string", "minLength": 1 },
    "platform": { "enum": ["linux-arm64", "darwin-arm64", "linux-amd64", "web"] },
    "sourceRevisions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sizeBytes": { "type": "integer", "minimum": 1 },
    "signature": { "type": "string", "minLength": 1 },
    "signingKeyId": { "type": "string", "minLength": 1 },
    "sbom": { "type": "string", "minLength": 1 },
    "buildReceipt": { "type": "string", "minLength": 1 },
    "licenseManifest": { "type": "string", "minLength": 1 },
    "sourceArchives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "sourceRevision"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "sourceRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" }
        }
      }
    }
  }
}
