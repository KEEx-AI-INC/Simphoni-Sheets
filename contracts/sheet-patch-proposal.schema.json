{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simphoni.ai/contracts/sheets/sheet-patch-proposal.v1.json",
  "title": "SheetPatchProposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposalId", "documentId", "baseRevision", "target", "operations", "estimatedCredits", "warnings"],
  "properties": {
    "proposalId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "documentId": { "type": "string", "minLength": 8, "maxLength": 128 },
    "baseRevision": { "type": "string", "minLength": 1, "maxLength": 128 },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sheetId", "range", "selectionHash"],
      "properties": {
        "sheetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "range": { "$ref": "#/$defs/a1Range" },
        "selectionHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "oneOf": [
        { "$ref": "#/$defs/setValues" },
        { "$ref": "#/$defs/setFormulas" },
        { "$ref": "#/$defs/formatCells" },
        { "$ref": "#/$defs/createOrUpdateChart" }
      ] }
    },
    "estimatedCredits": { "type": "number", "minimum": 0, "maximum": 100000 },
    "warnings": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 500 } }
  },
  "$defs": {
    "a1Range": { "type": "string", "pattern": "^(?:'[^']+'|[A-Za-z0-9_ -]+)?!?\\$?[A-Z]{1,3}\\$?[1-9][0-9]{0,6}(?::\\$?[A-Z]{1,3}\\$?[1-9][0-9]{0,6})?$", "maxLength": 256 },
    "matrix": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": ["string", "number", "boolean", "null"] } } },
    "setValues": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "range", "values"],
      "properties": { "kind": { "const": "setValues" }, "range": { "$ref": "#/$defs/a1Range" }, "values": { "$ref": "#/$defs/matrix" } }
    },
    "setFormulas": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "range", "formulas"],
      "properties": { "kind": { "const": "setFormulas" }, "range": { "$ref": "#/$defs/a1Range" }, "formulas": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "array", "minItems": 1, "maxItems": 1000, "items": { "type": "string", "pattern": "^=" } } } }
    },
    "formatCells": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "range", "format"],
      "properties": {
        "kind": { "const": "formatCells" }, "range": { "$ref": "#/$defs/a1Range" },
        "format": {
          "type": "object", "additionalProperties": false, "minProperties": 1,
          "properties": {
            "bold": { "type": "boolean" }, "italic": { "type": "boolean" }, "wrap": { "type": "boolean" },
            "horizontalAlign": { "enum": ["left", "center", "right"] },
            "numberFormat": { "type": "string", "maxLength": 128 },
            "foregroundColor": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}$" },
            "backgroundColor": { "type": "string", "pattern": "^#[A-Fa-f0-9]{6}$" }
          }
        }
      }
    },
    "createOrUpdateChart": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "chartId", "chartType", "sourceRange", "anchor", "size"],
      "properties": {
        "kind": { "const": "createOrUpdateChart" },
        "chartId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "chartType": { "enum": ["bar", "column", "line", "area", "pie", "scatter"] },
        "sourceRange": { "$ref": "#/$defs/a1Range" },
        "anchor": { "$ref": "#/$defs/a1Range" },
        "size": {
          "type": "object", "additionalProperties": false, "required": ["width", "height"],
          "properties": { "width": { "type": "integer", "minimum": 240, "maximum": 1600 }, "height": { "type": "integer", "minimum": 160, "maximum": 1200 } }
        },
        "title": { "type": "string", "maxLength": 200 },
        "legend": { "enum": ["none", "top", "right", "bottom", "left"] }
      }
    }
  }
}
